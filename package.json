{
  "name": "grand-theft-auckland",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && tsc --noEmit -p tools && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tools",
    "sim": "node --experimental-strip-types scripts/sim-car.ts",
    "smoke": "node scripts/smoke/run.mjs",
    "smoke:full": "node scripts/smoke/run.mjs --full",
    "citygen:fetch": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types tools/citygen/fetch.ts",
    "citygen:stats": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types tools/citygen/stats.ts",
    "citygen:parking": "node --experimental-strip-types tools/citygen/parking.ts",
    "citygen:places": "node --experimental-strip-types tools/citygen/places.ts",
    "citygen:roadgraph": "node --experimental-strip-types tools/citygen/roadgraph.ts",
    "citygen:build": "NODE_USE_ENV_PROXY=1 node --experimental-strip-types tools/citygen/build.ts"
  },
  "dependencies": {
    "@dimforge/rapier3d": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "earcut": "^3.2.4",
    "geotiff": "^3.0.5",
    "playwright": "^1.63.0",
    "proj4": "^2.22.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-wasm": "^3.6.0"
  }
}
